<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<StackPane fx:id="rootPane" styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.comp2042.ui.GuiController">

    <StackPane fx:id="scalableContainer"
               maxHeight="600.0" maxWidth="650.0"
               minHeight="600.0" minWidth="650.0"
               prefHeight="600.0" prefWidth="650.0">

        <HBox alignment="CENTER" spacing="20">

            <VBox alignment="TOP_CENTER" spacing="15">
                <padding>
                    <Insets top="60.0" />
                </padding>

                <VBox fx:id="holdBrickContainer" alignment="CENTER" minWidth="130" prefHeight="120.0" prefWidth="130.0" spacing="15" styleClass="scoreBox">
                    <Label alignment="TOP_LEFT" prefHeight="101.0" prefWidth="60.0" styleClass="scoreTitle" text="HOLD" />
                </VBox>

                <VBox fx:id="levelContainer" alignment="CENTER" minWidth="130" prefHeight="55.0" spacing="10.0" styleClass="scoreBox">
                    <Label prefHeight="30.0" prefWidth="75.0" styleClass="scoreTitle" text="LEVEL" />
                    <Label fx:id="levelLabel" prefHeight="22.0" styleClass="scoreValue" text="1">
                        <padding><Insets top="-10.0" /></padding>
                    </Label>
                </VBox>

                <VBox fx:id="linesContainer" alignment="CENTER" minWidth="130" prefHeight="55.0" prefWidth="130.0" spacing="5" styleClass="scoreBox">
                    <Label styleClass="scoreTitle" text="LINES" />
                    <Label fx:id="linesLabel" styleClass="scoreValue" text="0" />
                </VBox>

                <StackPane fx:id="groupNotification"
                           minHeight="40.0" maxHeight="40.0"
                           minWidth="130.0" maxWidth="130.0" prefWidth="130.0"
                           mouseTransparent="true">
                    <Label alignment="CENTER" prefWidth="130.0" styleClass="sideNotification" text="TETRIS" />
                </StackPane>

                <VBox prefHeight="20" />

                <HBox fx:id="bestTimeContainer" alignment="CENTER" minWidth="130" prefHeight="25.0" prefWidth="130.0" spacing="10" styleClass="scoreBox">
                    <Label styleClass="timeLabelStyle" style="-fx-text-fill: #e0d5c1;" text="BEST:" />
                    <Label fx:id="bestTimeLabel" styleClass="timeLabelStyle" style="-fx-text-fill: #e0d5c1;" text="--:--" />
                </HBox>

                <HBox alignment="CENTER" minWidth="130" prefHeight="25.0" prefWidth="130.0" spacing="10" styleClass="scoreBox">
                    <Label styleClass="timeLabelStyle" text="TIME:" />
                    <Label fx:id="timeLabel" styleClass="timeLabelStyle" text="00:00" />
                </HBox>
            </VBox>

            <Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="300.0">
                <GridPane fx:id="brickPanel" hgap="1" vgap="1" />
                <Pane fx:id="gameBoard" styleClass="gameBoard">
                    <GridPane fx:id="gamePanel" hgap="1" layoutX="40" layoutY="30" vgap="1" />
                </Pane>
            </Pane>

            <VBox alignment="TOP_CENTER" spacing="15">
                <padding>
                    <Insets top="60.0" />
                </padding>

                <VBox fx:id="nextBrickContainer" alignment="TOP_CENTER" minWidth="130" prefHeight="184.0" prefWidth="130.0" spacing="15" styleClass="scoreBox">
                    <Label alignment="TOP_CENTER" prefHeight="81.0" prefWidth="60.0" styleClass="scoreTitle" text="NEXT">
                        <padding><Insets top="10.0" /></padding>
                    </Label>
                </VBox>

                <HBox fx:id="highScoreContainer" alignment="CENTER" minWidth="130" prefHeight="40.0" spacing="5" styleClass="scoreBox">
                    <Label styleClass="timeLabelStyle" style="-fx-font-size: 8px; -fx-text-fill: #e0d5c1;" text="HI-SCORE:" />
                    <Label fx:id="highScoreLabel" styleClass="timeLabelStyle" style="-fx-text-fill: #e0d5c1;" text="0" />
                </HBox>

                <VBox fx:id="scoreContainer" alignment="CENTER" minHeight="120" minWidth="130" spacing="5" styleClass="scoreBox">
                    <Label styleClass="scoreTitle" text="SCORE" />
                    <Label fx:id="scoreLabel" styleClass="scoreValue" text="0" />
                </VBox>
            </VBox>

        </HBox>
    </StackPane>

    <StackPane fx:id="pauseMenu" styleClass="pause-overlay" visible="false">
        <VBox alignment="CENTER" spacing="20">
            <Label styleClass="pause-title" text="PAUSED" />
            <Button onAction="#resumeGame" styleClass="button" text="RESUME"  prefWidth="260" />
            <Button onAction="#restartGame" styleClass="button" text="RESTART" prefWidth="260" />
            <Button onAction="#openHowToFromPause" styleClass="button" text="HOW TO PLAY" prefWidth="260" />
            <Button onAction="#backToMenu" styleClass="button" text="MAIN MENU" prefWidth="260" />
            <Button onAction="#quitGame" styleClass="button, quit" text="QUIT" prefWidth="260"  />
        </VBox>

        <!-- HOW TO PLAY OVERLAY (IN-GAME) -->
        <StackPane fx:id="howToOverlayInGame"
                   visible="false"
                   opacity="0.0"
                   mouseTransparent="true"
                   style="-fx-background-color: rgba(0,0,0,0.75);">

            <VBox alignment="CENTER"
                  spacing="14"
                  prefWidth="380"
                  style="-fx-background-color: rgba(20,0,40,0.9);
                         -fx-padding: 24;
                         -fx-background-radius: 16;
                         -fx-border-radius: 16;
                         -fx-border-color: rgba(255,255,255,0.4);
                         -fx-border-width: 2;">

                <!-- TITLE -->
                <Label text="HOW TO PLAY"
                       alignment="CENTER"
                       textAlignment="CENTER"
                       style="-fx-font-family: 'Press Start 2P';
                              -fx-font-size: 18px;
                              -fx-text-fill: #ffb0ff;" />

                <!-- CONTROLS TITLE -->
                <Label text="Controls:"
                       alignment="CENTER"
                       textAlignment="CENTER"
                       style="-fx-font-family: 'Press Start 2P';
                              -fx-font-size: 10px;
                              -fx-text-fill: #ffffff;" />

                <!-- CONTROLS GRID (CENTERED) -->
                <GridPane hgap="24" vgap="6" alignment="CENTER">
                    <!-- Keys column -->
                    <Label text="← / → / A / D"  styleClass="howto-line" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <Label text="↑ / W"          styleClass="howto-line" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <Label text="↓ / S"          styleClass="howto-line" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <Label text="SPACE"          styleClass="howto-line" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                    <Label text="C"              styleClass="howto-line" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                    <Label text="P"              styleClass="howto-line" GridPane.rowIndex="5" GridPane.columnIndex="0" />

                    <!-- Action column -->
                    <Label text="Move left / right"
                           styleClass="howto-line"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    <Label text="Rotate piece"
                           styleClass="howto-line"
                           GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    <Label text="Soft drop"
                           styleClass="howto-line"
                           GridPane.rowIndex="2" GridPane.columnIndex="1" />
                    <Label text="Hard drop"
                           styleClass="howto-line"
                           GridPane.rowIndex="3" GridPane.columnIndex="1" />
                    <Label text="Hold current piece"
                           styleClass="howto-line"
                           GridPane.rowIndex="4" GridPane.columnIndex="1" />
                    <Label text="Pause / resume game"
                           styleClass="howto-line"
                           GridPane.rowIndex="5" GridPane.columnIndex="1" />
                </GridPane>

                <!-- MODES TITLE -->
                <Label text="Modes:"
                       alignment="CENTER"
                       textAlignment="CENTER"
                       style="-fx-font-family: 'Press Start 2P';
                              -fx-font-size: 10px;
                              -fx-text-fill: #ffffff;" />

                <!-- MODE DESCRIPTIONS -->
                <Label text="ZEN — Chill practice mode with infinite levels."
                       wrapText="true"
                       maxWidth="320"
                       alignment="CENTER"
                       textAlignment="CENTER"
                       styleClass="howto-line" />

                <Label text="ADVENTURE — Complete 6 levels (5 lines each). The game speeds up and mechanics change as you progress."
                       wrapText="true"
                       maxWidth="320"
                       alignment="CENTER"
                       textAlignment="CENTER"
                       styleClass="howto-line" />

                <!-- CLOSE BUTTON -->
                <Button text="CLOSE"
                        onAction="#closeHowToFromPause"
                        styleClass="button"
                        prefWidth="150"
                        prefHeight="30" />
            </VBox>
        </StackPane>
    </StackPane>

    <StackPane fx:id="centerNotificationOverlay" mouseTransparent="true" prefHeight="100.0" prefWidth="500.0" />
    <StackPane fx:id="scoreOverlay" mouseTransparent="true" prefHeight="100.0" prefWidth="500.0" translateY="130" />
    <Rectangle fx:id="redFlashOverlay" fill="RED" height="600.0" mouseTransparent="true" opacity="0.0" width="600.0" />

    <stylesheets>
        <URL value="@window_style.css" />
    </stylesheets>
</StackPane>