<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<?import javafx.scene.layout.GridPane?>
<StackPane fx:id="rootPane"
           styleClass="main-menu-bg"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.comp2042.ui.MainMenuController">

    <StackPane style="-fx-background-color: rgba(0, 0, 0, 0.3);" />

    <!-- MAIN MENU COLUMN -->
    <VBox alignment="CENTER"
          spacing="18"
          prefWidth="650"
          prefHeight="600">

        <!-- TITLE -->
        <Label fx:id="titleLabel"
                text="TETRIS"
               styleClass="title-text"/>

        <!-- SUBTITLE -->
        <Label text="Choose a Game Mode!"
               styleClass="subtitle"
               alignment="CENTER"
               style="-fx-font-size: 18px;"
               translateY="40"/>

        <VBox prefHeight="20" />

        <!-- BUTTONS -->
        <Button text="ZEN MODE"
                fx:id="zenBtn"
                onAction="#startZen"
                styleClass="button"
                prefWidth="260"
        />

        <Button text="ADVENTURE MODE"
                fx:id="AdventureBtn"
                onAction="#startAdventure"
                styleClass="button"
                prefWidth="260"
        />

        <Button text="HOW TO PLAY"
                onAction="#openHowToMenu"
                styleClass="button"
                prefWidth="260"
                prefHeight="32" />

    </VBox>

    <!-- CREDIT TEXT  -->
    <Label text="Made by Arianna Ainurizam © 2025"
           styleClass="menu-credit"
           StackPane.alignment="BOTTOM_RIGHT"
           translateX="-20"
           translateY="-15" />

    <!-- HOW-TO POPUP OVERLAY -->
    <StackPane fx:id="howToOverlay"
               visible="false"
               opacity="0.0"
               mouseTransparent="true"
               style="-fx-background-color: rgba(0,0,0,0.75);">

        <VBox alignment="CENTER"
              spacing="14"
              prefWidth="380"
              style="-fx-background-color: rgba(20,0,40,0.9);
                 -fx-padding: 24;
                 -fx-background-radius: 16;
                 -fx-border-radius: 16;
                 -fx-border-color: rgba(255,255,255,0.4);
                 -fx-border-width: 2;">

            <!-- TITLE -->
            <Label text="HOW TO PLAY"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   style="-fx-font-family: 'Press Start 2P';
                      -fx-font-size: 18px;
                      -fx-text-fill: #ffb0ff;" />

            <!-- CONTROLS TITLE -->
            <Label text="Controls:"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   style="-fx-font-family: 'Press Start 2P';
                      -fx-font-size: 10px;
                      -fx-text-fill: #ffffff;" />

            <!-- CONTROLS GRID (CENTERED) -->
            <GridPane hgap="24" vgap="6" alignment="CENTER">
                <!-- Keys column -->
                <Label text="← / → / A / D"  styleClass="howto-line" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <Label text="↑ / W"          styleClass="howto-line" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <Label text="↓ / S"          styleClass="howto-line" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <Label text="SPACE"          styleClass="howto-line" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <Label text="C"              styleClass="howto-line" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <Label text="ESC"              styleClass="howto-line" GridPane.rowIndex="5" GridPane.columnIndex="0" />

                <!-- Action column -->
                <Label text="Move left / right"
                       styleClass="howto-line"
                       GridPane.rowIndex="0" GridPane.columnIndex="1" />
                <Label text="Rotate piece"
                       styleClass="howto-line"
                       GridPane.rowIndex="1" GridPane.columnIndex="1" />
                <Label text="Soft drop"
                       styleClass="howto-line"
                       GridPane.rowIndex="2" GridPane.columnIndex="1" />
                <Label text="Hard drop"
                       styleClass="howto-line"
                       GridPane.rowIndex="3" GridPane.columnIndex="1" />
                <Label text="Hold current piece"
                       styleClass="howto-line"
                       GridPane.rowIndex="4" GridPane.columnIndex="1" />
                <Label text="Pause / resume game"
                       styleClass="howto-line"
                       GridPane.rowIndex="5" GridPane.columnIndex="1" />
            </GridPane>

            <!-- MODES TITLE -->
            <Label text="Modes:"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   style="-fx-font-family: 'Press Start 2P';
                      -fx-font-size: 10px;
                      -fx-text-fill: #ffffff;" />

            <!-- MODE DESCRIPTIONS -->
            <Label text="ZEN — Chill practice mode with infinite levels."
                   wrapText="true"
                   maxWidth="320"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   styleClass="howto-line" />

            <Label text="ADVENTURE — Complete 6 levels (5 lines each). The game speeds up and mechanics change as you progress!"
                   wrapText="true"
                   maxWidth="320"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   styleClass="howto-line" />

            <!-- CLOSE BUTTON -->
            <Button text="CLOSE"
                    onAction="#closeHowToMenu"
                    styleClass="button"
                    prefWidth="150"
                    prefHeight="30" />
        </VBox>
    </StackPane>



    <!-- STYLE SHEET -->
    <stylesheets>
        <URL value="@window_style.css" />
    </stylesheets>

</StackPane>
